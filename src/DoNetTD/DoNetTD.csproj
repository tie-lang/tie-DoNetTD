<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DoNetTD</RootNamespace>
    <AssemblyName>DoNetTD</AssemblyName>

    <!-- NuGet 包元数据 -->
    <PackageId>DoNetTD</PackageId>
    <Version>0.3.0</Version>
    <Authors>TIE-LANG organization</Authors>
    <Owners>TIE-LANG organization</Owners>
    <Company>TIE-LANG organization</Company>
    <Product>tie:data .NET library</Product>
    <Description>.NET 解析库 for tie:data —— tie 语言数据交换格式的解析、写入、创建、转化与高级操作（路径查询、深合并、POCO 映射、JSON 互转）。</Description>
    <Summary>Parse, write, create, convert and manipulate tie:data documents from .NET.</Summary>
    <PackageTags>tie;tie-lang;tiedata;data;parser;config;serialization</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryUrl>https://github.com/TIE-LANG/tie-DoNetTD</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/TIE-LANG/tie-DoNetTD</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <!-- 构建质量 -->
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CA1510;CA1720;CA1866;CA1310;CA1859;CA2263</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- 源链接 -->
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
