<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DoNetTD.Extensions.Configuration</RootNamespace>

    <PackageId>DoNetTD.Extensions.Configuration</PackageId>
    <Version>0.3.0</Version>
    <Authors>TIE-LANG organization</Authors>
    <Owners>TIE-LANG organization</Owners>
    <Company>TIE-LANG organization</Company>
    <Description>tet:data configuration provider for Microsoft.Extensions.Configuration —— 把 tie:data 文件接入 .NET 通用配置体系（IConfiguration），支持 optional/reloadOnChange。</Description>
    <PackageTags>tie;tiedata;configuration;config;extensions</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryUrl>https://github.com/tie-lang/DoNetTD</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DoNetTD\DoNetTD.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
